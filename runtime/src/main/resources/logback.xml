<!--
  Master logback configuration — lives in runtime.jar (Runtime ClassLoader).

  Solution I (supplier hooks) drives this file as XML *after* the Runtime layer
  has already done two things programmatically:

  1. Registered every custom conversionRule as a Supplier<DynamicConverter>
     (CorrelationIdConverter::new, RewriteMessageConverter::new,
     RewriteLoggerConverter::new) in PATTERN_RULE_REGISTRY_FOR_SUPPLIERS.
     => The %correlationId / %rewriteMsg / %rewriteLogger words below resolve
        via supplier.get(); logback never loads a runtime class by name, so
        there is no cross-CL Class.forName. (No <conversionRule> needed, and no
        document-order constraint — the words exist before this appender starts.)

  2. Published the app fragment's URL (resolved via appCL) as the
     ${appFragmentUrl} property.
     => The <include url="..."> below is opened with new URL(...), NOT through
        Loader.getResourceBySelfClassLoader — so app.jar need not be visible to
        logback's own (SDK) classloader.

  What is NOT here: the custom <filter> and the custom JSON <layout>. Filters and
  layouts have no supplier registry, so a runtime-only filter/layout class can't
  be named in XML across the CL boundary. RuntimeMain builds those programmatically
  after configuration (the ThresholdRangeFilter on CONSOLE, plus a second JSON
  appender carrying JsonLayout + its nested jsonFormatter and the KafkaLogFilter).

  Toggle debug="true" to see logback's own class-loading trace.
-->
<configuration debug="false">

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!-- %rewriteLogger(...) is a composite converter; %rewriteMsg a simple one. -->
      <pattern>[%d{HH:mm:ss.SSS}] [%correlationId] [%-5level] [%rewriteLogger(%logger)] %rewriteMsg%n</pattern>
    </encoder>
  </appender>

  <!-- App fragment, included BY URL (resolved by the Runtime layer via appCL). -->
  <include url="${appFragmentUrl}" optional="true"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>

</configuration>
